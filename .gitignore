/android/app/release

# Widget Preview related
.widget_preview/

# Fetched by the native_imaging build (ONNX Runtime, the subject model).
/packages/native_imaging/third_party/

# Build output anywhere, including android/build and the local package.
build/

# Kept on this PC, not on GitHub: notes for Claude and editor settings.
/CLAUDE.md
/.vscode/
/devtools_options.yaml

# Made by Flutter inside the local package.
packages/*/pubspec.lock
